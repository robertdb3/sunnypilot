--- /dev/null
+++ b/openpilot/sunnypilot/selfdrive/car/intelligent_cruise_button_management/voice_override.py
@@ -0,0 +1,133 @@
+"""Fail-closed absolute-speed override transported outside cereal over local datagrams."""
+from __future__ import annotations
+
+import json
+import os
+import socket
+import time
+
+
+COMMANDD_SOCKET = "/tmp/custompilot-commandd.sock"
+ICBM_SOCKET = "/tmp/custompilot-icbm.sock"
+MAX_DELTA_MPH = 20
+MAX_TAPS = 4
+COMMAND_TIMEOUT = 12.0
+PROGRESS_TIMEOUT = 2.5
+STATUS_INTERVAL = 0.1
+
+
+class VoiceCruiseOverride:
+  def __init__(self, bind_socket: bool = True, clock=time.monotonic):
+    self.clock = clock
+    self.sock: socket.socket | None = None
+    self.target_mph: int | None = None
+    self.command_id: str | None = None
+    self.outcome = "idle"
+    self.reason = ""
+    self.deadline = 0.0
+    self.progress_deadline = 0.0
+    self.last_cluster = 0
+    self.taps = 0
+    self.last_status = 0.0
+    if bind_socket:
+      try:
+        os.unlink(ICBM_SOCKET)
+      except FileNotFoundError:
+        pass
+      self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
+      self.sock.setblocking(False)
+      self.sock.bind(ICBM_SOCKET)
+      os.chmod(ICBM_SOCKET, 0o600)
+
+  def _clear(self, outcome: str, reason: str) -> None:
+    self.target_mph = None
+    self.outcome = outcome
+    self.reason = reason
+
+  def _accept(self, message: dict, current: int, minimum: int, maximum: int, ready: bool) -> None:
+    target = message.get("target_mph")
+    expected = message.get("current_mph")
+    command_id = message.get("id")
+    # A newly confirmed request supersedes any previous voice target, even if it is rejected.
+    self._clear("rejected", "invalid request")
+    self.command_id = command_id if isinstance(command_id, str) else None
+    if (type(target) is not int or target <= 0 or target % 5 or type(expected) is not int or
+        not self.command_id):
+      self.reason = "invalid target"
+      return
+    if not ready or current != expected:
+      self.reason = "readiness or current speed changed"
+      return
+    if not minimum <= target <= maximum or abs(target - current) > MAX_DELTA_MPH:
+      self.reason = "target outside bounds"
+      return
+    now = self.clock()
+    self.target_mph = target
+    self.outcome = "holding" if target == current else "running"
+    self.reason = ""
+    self.deadline = now + COMMAND_TIMEOUT
+    self.progress_deadline = now + PROGRESS_TIMEOUT
+    self.last_cluster = current
+    self.taps = 0
+
+  def _drain(self, current: int, minimum: int, maximum: int, ready: bool) -> None:
+    if self.sock is None:
+      return
+    while True:
+      try:
+        message = json.loads(self.sock.recv(4096).decode("utf-8"))
+      except BlockingIOError:
+        return
+      except (OSError, UnicodeDecodeError, json.JSONDecodeError):
+        continue
+      msg_type = message.get("type")
+      if msg_type == "set_target":
+        self._accept(message, current, minimum, maximum, ready)
+      elif msg_type == "resume_assist":
+        self.command_id = None
+        self._clear("cleared", "speed limit assist resumed")
+      elif msg_type == "physical_button":
+        self._clear("cleared", "physical cruise button")
+      elif msg_type == "synthetic_tap" and self.target_mph is not None:
+        self.taps += 1
+        if self.taps > MAX_TAPS:
+          self._clear("aborted", "synthetic tap limit")
+
+  def update(self, current: int, minimum: int, maximum: int, ready: bool, icbm_enabled: bool,
+             acc_engaged: bool, imperial: bool, driver_override: bool = False,
+             button_active: bool = False) -> int | None:
+    effective_ready = ready and icbm_enabled and acc_engaged and imperial and not driver_override and not button_active
+    self._drain(current, minimum, maximum, effective_ready)
+    now = self.clock()
+
+    if self.target_mph is not None:
+      if not effective_ready:
+        self._clear("cleared", "cruise readiness changed")
+      elif current != self.last_cluster:
+        self.last_cluster = current
+        self.progress_deadline = now + PROGRESS_TIMEOUT
+      if self.target_mph is not None and current == self.target_mph:
+        self.outcome = "holding"
+      elif self.target_mph is not None and (now > self.deadline or now > self.progress_deadline):
+        self._clear("aborted", "command timeout" if now > self.deadline else "no cluster progress")
+
+    self._send_status(current, minimum, maximum, effective_ready, icbm_enabled, acc_engaged,
+                      imperial, driver_override, button_active)
+    return self.target_mph
+
+  def _send_status(self, current: int, minimum: int, maximum: int, ready: bool, icbm_enabled: bool,
+                   acc_engaged: bool, imperial: bool, driver_override: bool, button_active: bool) -> None:
+    if self.sock is None or self.clock() - self.last_status < STATUS_INTERVAL:
+      return
+    self.last_status = self.clock()
+    payload = {
+      "type": "status", "ready": ready, "icbm_enabled": icbm_enabled,
+      "acc_engaged": acc_engaged, "imperial": imperial, "driver_override": driver_override,
+      "button_active": button_active, "current_mph": current, "minimum_mph": minimum,
+      "maximum_mph": maximum, "target_mph": self.target_mph, "command_id": self.command_id,
+      "outcome": self.outcome, "reason": self.reason, "taps": self.taps,
+    }
+    try:
+      self.sock.sendto(json.dumps(payload, separators=(",", ":")).encode("utf-8"), COMMANDD_SOCKET)
+    except OSError:
+      pass
