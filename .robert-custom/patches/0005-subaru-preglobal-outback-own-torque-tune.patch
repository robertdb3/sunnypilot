 "SUBARU_OUTBACK_PREGLOBAL" = "SUBARU_IMPREZA"
 "SUBARU_FORESTER_PREGLOBAL" = "SUBARU_IMPREZA"
 "SUBARU_LEGACY_PREGLOBAL" = "SUBARU_IMPREZA"
